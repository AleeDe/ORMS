# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Dashboard → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service-role key. Bypasses RLS — never expose to the browser.
# Needed for storing OAuth refresh tokens and handling Resend webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app — used to build OAuth redirects. Set to your domain in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Calendar OAuth (Google Cloud Console → APIs & Services → Credentials) ---
# Enable "Google Calendar API", create an OAuth Web client, and add this redirect URI:
#   http://localhost:3000/api/google/callback   (and your production URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Encryption secret for API keys stored in the database ---
# Resend API keys are NOT configured here — they are added in the app
# (Settings → Email → Resend accounts), so several Resend accounts can be
# connected at once and their domains pooled. This secret encrypts them at rest.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every connected account unreadable and they must be reconnected.
ENCRYPTION_SECRET=

# Resend webhooks (optional, for delivery/bounce tracking):
#   Resend → Webhooks → https://<your-domain>/api/email/webhook
