# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Dashboard → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service-role key. Bypasses RLS — never expose to the browser.
# Needed for storing OAuth refresh tokens.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app — used to build OAuth redirects. Set to your domain in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Workspace invitation emails (server only). Use a sender on a verified Resend domain.
# Keep false for invitations shared by link. Enable explicitly when email delivery is wanted.
WORKSPACE_INVITATION_EMAIL_ENABLED=false
# Optional public origin for shared links; defaults to NEXT_PUBLIC_APP_URL.
# Useful when developing locally while sharing invitations to the hosted app.
WORKSPACE_INVITATION_APP_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=ORMS <invitations@yourdomain.com>

# --- Google Calendar OAuth (Google Cloud Console → APIs & Services → Credentials) ---
# Enable "Google Calendar API", create an OAuth Web client, and add this redirect URI:
#   http://localhost:3000/api/google/callback   (and your production URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
